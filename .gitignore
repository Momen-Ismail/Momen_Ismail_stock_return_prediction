# --------------------------------------------------
# Python
# --------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/

.venv/
venv/
env/


# --------------------------------------------------
# macOS and editors
# --------------------------------------------------
.DS_Store
.vscode/


# --------------------------------------------------
# Local caches and backups
# --------------------------------------------------
.matplotlib/
backup/


# --------------------------------------------------
# Generated project outputs
# --------------------------------------------------
output/data/*
output/models/*
output/reports/*
output/quality/*


# Keep the empty output-folder structure
!output/data/staging/
output/data/staging/*
!output/data/staging/.gitkeep

!output/data/final/
output/data/final/*
!output/data/final/.gitkeep

!output/models/.gitkeep
!output/models/tuning/
output/models/tuning/*
!output/models/tuning/tuning_migration_provenance.json
!output/models/tuning/official_step06_parity_report.json
!output/reports/.gitkeep
!output/quality/.gitkeep


# --------------------------------------------------
# Large model and binary artifacts outside output/
# --------------------------------------------------
*.parquet
*.h5
*.pkl
*.joblib
*.zip


# --------------------------------------------------
# Reproducibility inputs
# --------------------------------------------------
# Ignore input contents by default, then retain only
# the permanent inputs required to reproduce the project.
input/*

# Locked stock universe and market inputs
!input/stock_universe_locked.csv
!input/market_gspc_daily.csv
!input/market_vix_daily.csv
!input/input_manifest.csv

# Cleaned external inputs
!input/external/
input/external/*
!input/external/fama_french_rf_monthly.csv
!input/external/welch_goyal_macro_1990_2025.csv

# Original Welch-Goyal workbook
!input/raw/
input/raw/*
!input/raw/PredictorData2025.xlsx


# --------------------------------------------------
# Logs
# --------------------------------------------------
*.log


# --------------------------------------------------
# LaTeX temporary files
# --------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv


# --------------------------------------------------
# Final documentation assets
# --------------------------------------------------
# Final figures and LaTeX tables are intentionally tracked.
!documentation/figures/
!documentation/figures/*.png

!documentation/tables/
!documentation/tables/*.tex


# Ignore generated PDFs by default, but retain the final
# paper and the data-construction guide.
documentation/pdf/*
!documentation/pdf/.gitkeep
!documentation/pdf/Momen Ismail.pdf
!documentation/pdf/Data_Construction_Guide.pdf

# PDFs generated beside LaTeX sources
documentation/documents/**/*.pdf

# --------------------------------------------------
# Internal final-submission audit
# --------------------------------------------------
# This report is used to prepare the submission but is not
# part of the public final project.
documentation/documents/final_submission_audit/
documentation/tables/final_submission_*.csv
documentation/pdf/final_submission_audit.pdf
documentation/documents/**/*.pdf
